# ————————————————————————————————————————————————————————————
# Del — نمونه تنظیمات محیطی (فقط نمونه؛ مقادیر واقعی را کامیت نکنید)
# Copy to .env and fill with real values. Never commit .env.
# ————————————————————————————————————————————————————————————

# Runtime
NODE_ENV=development
PORT=3000
API_PUBLIC_URL=https://api.del.example.com
WEB_PUBLIC_URL=https://app.del.example.com

# PostgreSQL
DATABASE_URL=postgresql://del_user:CHANGE_ME@localhost:5432/del?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT / Sessions — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# ————— SMS ورود (کد تأیید) — پشتیبانی از همهٔ کشورها —————
# ایران (+98) → کاوه‌نگار
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=            # اختیاری — خط خدماتی
KAVENEGAR_OTP_TEMPLATE=      # اختیاری — نام قالب Verify Lookup در پنل
# سایر کشورها (ترکیه +90، افغانستان +93، آلمان +49، …) → Twilio
# حساب رایگان در twilio.com بسازید، یک شماره بخرید و مقادیر را اینجا بگذارید
TWILIO_ACCOUNT_SID=          # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # شماره فرستنده Twilio مثل +14155552671
TWILIO_MESSAGING_SERVICE_SID=  # اختیاری — به‌جای شماره فرستنده
# حالت توسعه (بدون SMS): AUTH_DEV_MODE=true کد را در پاسخ API و لاگ سرور نشان می‌دهد
AUTH_DEV_MODE=true
OTP_PER_PHONE_LIMIT=3
OTP_PHONE_WINDOW_SEC=600
OTP_PER_IP_LIMIT=20
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
# شماره‌های ادمین جداشده با کاما
ADMIN_PHONES=

# Object Storage (S3-compatible / MinIO for dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=del-media
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# LiveKit (SFU for voice/video)
LIVEKIT_URL=wss://livekit.del.example.com
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# Push notifications
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=           # path to .p8 key, NOT committed
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=  # path to service account JSON, NOT committed

# AI provider (server-side only — never expose to clients)
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
