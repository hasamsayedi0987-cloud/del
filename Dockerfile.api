# ============================================================
# Del API — production image (multi-stage, pnpm monorepo)
# Build from repo root:
#   docker build -f Dockerfile.api -t del-api:latest .
# Run:
#   docker run -p 3000:3000 --env-file .env del-api:latest
# ============================================================
# بیس دبیان (نه alpine): موتورهای Prisma و sharp بدون مشکل libssl/openssl کار می‌کنند
# بدون «pnpm deploy» و بدون کپی استور بین مراحل — فقط نصب و بیلد استاندارد workspace

FROM node:20-bookworm-slim AS build
RUN npm install -g --silent pnpm@9.15.9
WORKDIR /repo

# ---------- deps (لایهٔ کش‌شونده) ----------
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared-types/package.json packages/shared-types/
RUN pnpm install --frozen-lockfile --filter @del/api...

# ---------- sources + build ----------
COPY packages/shared-types packages/shared-types
COPY apps/api apps/api
RUN pnpm --filter @del/shared-types build \
    && pnpm --filter @del/api db:generate \
    && pnpm --filter @del/api build

# ---------- runner ----------
FROM node:20-bookworm-slim AS runner
ENV NODE_ENV=production
RUN groupadd --system del && useradd --system --gid del --home-dir /repo del
WORKDIR /repo

# همان ساختار workspace حفظ می‌شود — سیم‌لینک‌های pnpm سالم می‌مانند
COPY --from=build --chown=del:del /repo/node_modules ./node_modules
COPY --from=build --chown=del:del /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=build --chown=del:del /repo/packages/shared-types ./packages/shared-types
COPY --from=build --chown=del:del /repo/apps/api/dist ./apps/api/dist
COPY --from=build --chown=del:del /repo/apps/api/prisma ./apps/api/prisma
COPY --from=build --chown=del:del /repo/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=del:del /repo/package.json ./
COPY --from=build --chown=del:del /repo/pnpm-workspace.yaml ./

USER del
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /repo/apps/api
# prisma CLI از وابستگی‌های پروداکشن خود پروژه — بدون npx و بدون اینترنت در زمان اجرا
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/main.js"]
