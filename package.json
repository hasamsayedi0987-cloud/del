{
  "name": "del",
  "version": "0.3.0",
  "private": true,
  "description": "Del (دل) — secure cross-platform messenger for iOS, Android, Windows and macOS",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @del/api db:migrate",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
