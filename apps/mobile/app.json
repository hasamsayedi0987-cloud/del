{
  "expo": {
    "name": "دل",
    "slug": "del",
    "version": "1.5.1",
    "orientation": "portrait",
    "scheme": "del",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#38BDF8"
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "bundleIdentifier": "ir.del.app",
      "supportsTablet": true
    },
    "android": {
      "package": "ir.del.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}