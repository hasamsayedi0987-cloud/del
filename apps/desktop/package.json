{
  "name": "@del/desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Del messenger - desktop app (Electron) for Windows / macOS / Linux",
  "main": "dist/main.js",
  "author": "Del Team",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --external:electron --outfile=dist/main.js",
    "dist": "electron-builder --config electron-builder.yml",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "typescript": "5.6.3"
  }
}
