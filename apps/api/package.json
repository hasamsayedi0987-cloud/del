{
  "name": "@del/api",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Del messenger API — REST + WebSocket (alpha build, SQLite storage)",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node18 --outfile=dist/server.js --external:better-sqlite3 --external:socket.io --external:express --external:jsonwebtoken --external:cors --external:better-sqlite3",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/better-sqlite3": "^7.6.12",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
