# تنظیمات محلی API — این فایل کامیت نمی‌شود (.gitignore)
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://del_user:del_dev_password@localhost:5432/del?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev_access_2f8b1c4e9a7d3f6b0c5e8a1d4f7b2e9c
JWT_REFRESH_SECRET=dev_refresh_7c1e4a9d3b6f0e2a5c8d1f4b7e0a3c6d
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# در حالت dev کد OTP در پاسخ API برگردانده می‌شود (سرویس SMS هنوز متصل نیست)
AUTH_DEV_MODE=true
OTP_PER_PHONE_LIMIT=3
OTP_PHONE_WINDOW_SEC=600
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
# ————— رسانه (گام ۵) — S3/MinIO —————
# اگر این مقادیر ست نشوند، endpointهای رسانه 503 MEDIA_NOT_CONFIGURED می‌دهند
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=del-media
S3_ACCESS_KEY=del_minio
S3_SECRET_KEY=del_dev_minio_password
S3_FORCE_PATH_STYLE=true
MEDIA_SIGNED_URL_TTL_SEC=300
MEDIA_MULTIPART_THRESHOLD_MB=10
MEDIA_PART_SIZE_MB=8
MEDIA_MAX_IMAGE_MB=25
MEDIA_MAX_FILE_MB=1024
# ————— تماس‌ها (گام ۶) — LiveKit SFU —————
# اگر این مقادیر ست نشوند، endpointهای تماس 503 CALLS_DISABLED می‌دهند (بقیه اپ سالم)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-0123456789abcdef0123456789abcdef
LIVEKIT_TOKEN_TTL_SEC=3600
CALL_RING_TIMEOUT_SEC=45
# ————— اعلان‌ها (گام ۷) — Push —————
# webhook تست/یکپارچه‌سازی: کل payload اعلان به این URL POST می‌شود (اختیاری)
PUSH_WEBHOOK_URL=
# ارسال توکن‌های Expo به سرویس Expo Push (پیش‌فرض true — برای تست خودکار false کنید)
PUSH_EXPO_ENABLED=true
