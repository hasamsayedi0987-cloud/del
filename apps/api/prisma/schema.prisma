// Del — Step 1 schema (Auth foundation)
// جداول پیام‌رسانی (Conversation/Message/...) در گام‌های بعدی اضافه می‌شوند — docs/04-data-model.md
// TODO(perf): در گام ۲ مهاجرت به UUIDv7 در لایه اپلیکیشن (سازگار با docs/04)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @unique // فرمت E.164 مثل +989121234567
  displayName String?
  avatarUrl   String?
  about       String?
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices        Device[]
  refreshTokens  RefreshToken[]
  participations Participant[]
  messages       Message[]
  mediaAssets    MediaAsset[]
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  platform     String // android | ios | windows | macos | linux | web
  name         String?
  pushToken    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// کد یک‌بارمصرف ورود — فقط هش ذخیره می‌شود، هرگز خودِ کد
model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String // sha256(code + salt)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String?   @db.Uuid
  tokenHash    String    @unique // sha256(token)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ————— پیام‌رسانی (گام ۲) —————
// قرارداد: هر پیام server_seq یگانه در مکالمه دارد؛ client_msg_id برای idempotency

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  type          String    @default("direct") // direct | group (گروه در گام بعدی)
  title         String?
  lastSeq       Int       @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  participants Participant[]
  messages     Message[]
  mediaAssets  MediaAsset[]

  @@index([lastMessageAt])
}

model Participant {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @default("member") // member | admin (گروه‌ها — گام ۴)
  lastReadSeq    Int      @default(0)
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  serverSeq      Int
  clientMsgId    String // UUID تولیدشده سمت کلاینت — تضمین تحویل idempotent
  type           String    @default("text") // text | image | video | audio | file (رسانه — گام ۵)
  body           String
  mediaId        String?   @db.Uuid
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  media        MediaAsset?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([conversationId, serverSeq])
  @@unique([conversationId, clientMsgId])
  @@index([conversationId, serverSeq])
}

// ————— رسانه (گام ۵) —————
// بایت‌ها هرگز از API عبور نمی‌کنند — آپلود/دانلود مستقیم با Presigned URL از S3/MinIO

model MediaAsset {
  id             String    @id @default(uuid()) @db.Uuid
  ownerId        String    @db.Uuid
  conversationId String    @db.Uuid
  kind           String // image | video | audio | file
  mime           String // از whitelist سرور — در complete با magic bytes تأیید می‌شود
  size           Int // بایت‌های ادعاشده در presign
  originalName   String?
  width          Int?
  height         Int?
  status         String    @default("pending") // pending | ready | rejected
  storageKey     String    @unique
  uploadId       String? // فقط multipart — برای complete/abort
  thumbKey       String?
  error          String?
  createdAt      DateTime  @default(now())
  readyAt        DateTime?

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([conversationId])
  @@index([ownerId])
}
