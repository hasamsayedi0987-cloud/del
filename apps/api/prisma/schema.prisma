// Del — Step 1 schema (Auth foundation)
// جداول پیام‌رسانی (Conversation/Message/...) در گام‌های بعدی اضافه می‌شوند — docs/04-data-model.md
// TODO(perf): در گام ۲ مهاجرت به UUIDv7 در لایه اپلیکیشن (سازگار با docs/04)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  // ورود با شماره یا ایمیل — هر کاربر حداقل یکی را دارد
  phone       String?  @unique // فرمت E.164 مثل +989121234567 (کاربرِ ایمیل‌محور null است)
  email       String?  @unique // حروف کوچک‌شده — ورود با کد ایمیل
  displayName String?
  avatarUrl   String?
  about       String?
  lastSeenAt  DateTime?
  /** رضایت کلی برای هوش مصنوعی (گام ۹) — بدون آن هیچ محتوایی به سرویس AI نمی‌رود */
  aiConsent   Boolean  @default(false)
  /** نقش سیستمی (گام ۱۰) — admin به پنل مدیریت دسترسی دارد */
  role        String   @default("user") // user | admin
  /** مسدودشده توسط ادمین (گام ۱۰) — ورود/توکن/WS بلافاصله بسته می‌شود */
  blockedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices        Device[]
  refreshTokens  RefreshToken[]
  participations Participant[]
  messages       Message[]
  mediaAssets    MediaAsset[]
  callsPlaced    Call[]         @relation("callsPlaced")
  callsReceived  Call[]         @relation("callsReceived")
  e2eeIdentities E2eeIdentity[]
  e2eeBackup     E2eeKeyBackup?
  aiUsage        AiUsage[]
  reportsFiled   UserReport[]   @relation("reporter")
  reportsAgainst UserReport[]   @relation("reported")
  blocksIssued   UserBlock[]    @relation("blocker")
  blocksReceived UserBlock[]    @relation("blocked")
  auditEntries   AuditLog[]
  stories        Story[]
  storyViews     StoryView[]
  /** عکس پروفایل — بایت تصویر کوچک (≤256px) در دیتابیس؛ سرو با GET /users/:id/avatar */
  avatarImage    Bytes?
  avatarMime     String?
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  platform     String // android | ios | windows | macos | linux | web
  name         String?
  pushToken    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// کد یک‌بارمصرف ورود — فقط هش ذخیره می‌شود، هرگز خودِ کد
model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String? // یا phone یا email پر می‌شود
  email      String?
  codeHash   String // sha256(code + salt)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([email, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String?   @db.Uuid
  tokenHash    String    @unique // sha256(token)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ————— پیام‌رسانی (گام ۲) —————
// قرارداد: هر پیام server_seq یگانه در مکالمه دارد؛ client_msg_id برای idempotency

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  type          String    @default("direct") // direct | group (گروه در گام بعدی)
  title         String?
  lastSeq       Int       @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  /** پیام‌های محوشونده (v1.4) — 0 = خاموش، وگرنه TTL به ثانیه (86400 = ۲۴ ساعت) */
  disappearSec  Int       @default(0)
  /** همگام‌سازی افزایشی (گام ۷) — با هر تغییر (پیام/نام/عضویت غیرمستقیم) به‌روز می‌شود */
  updatedAt     DateTime  @default(now()) @updatedAt

  participants Participant[]
  messages     Message[]
  mediaAssets  MediaAsset[]
  calls        Call[]
  aiUsage      AiUsage[]

  @@index([lastMessageAt])
  @@index([updatedAt])
}

model Participant {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @default("member") // member | admin (گروه‌ها — گام ۴)
  lastReadSeq    Int      @default(0)
  /** رضایت هوش مصنوعی در همین گفتگو (گام ۹) — null = تبعیت از رضایت کلی کاربر */
  aiConsent      Boolean?
  joinedAt       DateTime @default(now())
  /** همگام‌سازی افزایشی (گام ۷) — خواندن/تغییر نقش/پیوستن این سطر را تازه می‌کند */
  updatedAt      DateTime @default(now()) @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([updatedAt])
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  serverSeq      Int
  clientMsgId    String // UUID تولیدشده سمت کلاینت — تضمین تحویل idempotent
  type           String    @default("text") // text | image | video | audio | file (رسانه — گام ۵)
  body           String
  /** رمزنگاری سرتاسری (گام ۸) — body پاکت رمز است و سرور محتوایش را نمی‌فهمد */
  isE2ee         Boolean   @default(false)
  mediaId        String?   @db.Uuid
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  /** پیام محوشونده (v1.4) — اگر تنظیم شود در این زمان توسط cleanup حذف می‌شود */
  expiresAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  media        MediaAsset?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([conversationId, serverSeq])
  @@unique([conversationId, clientMsgId])
  @@index([conversationId, serverSeq])
}

// ————— رسانه (گام ۵) —————
// بایت‌ها هرگز از API عبور نمی‌کنند — آپلود/دانلود مستقیم با Presigned URL از S3/MinIO

model MediaAsset {
  id             String    @id @default(uuid()) @db.Uuid
  ownerId        String    @db.Uuid
  conversationId String    @db.Uuid
  kind           String // image | video | audio | file
  mime           String // از whitelist سرور — در complete با magic bytes تأیید می‌شود
  size           Int // بایت‌های ادعاشده در presign
  originalName   String?
  width          Int?
  height         Int?
  status         String    @default("pending") // pending | ready | rejected
  storageKey     String    @unique
  uploadId       String? // فقط multipart — برای complete/abort
  thumbKey       String?
  error          String?
  createdAt      DateTime  @default(now())
  readyAt        DateTime?

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([conversationId])
  @@index([ownerId])
}

// ————— تماس‌ها (گام ۶) —————
// signaling روی WS + مدیا از LiveKit (SFU) — بایت‌های صدا/تصویر از API عبور نمی‌کنند

model Call {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  callerId       String    @db.Uuid
  calleeId       String    @db.Uuid
  kind           String // audio | video
  status         String    @default("ringing") // ringing | active | ended | missed | rejected | cancelled
  endReason      String? // hangup | reject | cancel | timeout
  startedAt      DateTime  @default(now()) // لحظه شروع زنگ
  connectedAt    DateTime?
  endedAt        DateTime?
  durationS      Int? // طول گفت‌وگوی مؤثر بر حسب ثانیه
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("callsPlaced", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User         @relation("callsReceived", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([callerId])
  @@index([calleeId])
  @@index([calleeId, status])
  @@index([callerId, status])
}

// ————— رمزنگاری سرتاسری (گام ۸) —————
// فقط کلیدهای «عمومی» روی سرور می‌نشینند — خصوصی‌ها هرگز از دستگاه خارج نمی‌شوند
// به‌جز پشتیبانِ رمزشده با کلید بازیابی (E2eeKeyBackup) که سرور کلیدش را ندارد

model E2eeIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  deviceId  String // UUID دستگاه (از JWT did) — هر دستگاه یک هویت
  ikEd      String // کلید عمومی امضای هویت (Ed25519, b64)
  ikX       String // کلید عمومی DH هویت (X25519, b64)
  spkKeyId  Int
  spk       String // کلید عمومی پیش‌امضاشده (b64)
  spkSig    String // امضای spk با ikEd (b64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  otks E2eeOneTimePreKey[]

  @@unique([userId, deviceId])
  @@index([userId])
}

model E2eeOneTimePreKey {
  id         String    @id @default(uuid()) @db.Uuid
  identityId String    @db.Uuid
  keyId      Int
  pubKey     String // b64
  usedAt     DateTime? // با دریافت bundle مصرف می‌شود (یگانه)
  createdAt  DateTime  @default(now())

  identity E2eeIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, keyId])
  @@index([identityId, usedAt])
}

/** پشتیبان هویت — blob رمزشده با کلید مشتق از کلید بازیابی کاربر (AES/HKDF سمت دستگاه) */
model E2eeKeyBackup {
  userId    String   @id @db.Uuid
  blob      String
  salt      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ————— هوش مصنوعی (گام ۹) —————
// ثبت مصرف برای کنترل هزینه — فقط متادیتا، هرگز محتوای پیام

model AiUsage {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  conversationId String?  @db.Uuid
  feature        String // translate | fix | suggest | summarize
  provider       String // mock | openai | webhook
  /** آیا فراخوانی provider موفق بود؟ */
  ok             Boolean
  /** طول متن ورودی/خروجی به کاراکتر (محتوای واقعی ذخیره نمی‌شود) */
  charsIn        Int      @default(0)
  charsOut       Int      @default(0)
  promptTokens   Int?
  completionTokens Int?
  latencyMs      Int      @default(0)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId])
}

// ————— مدیریت، گزارش و مسدودسازی (گام ۱۰) —————
// گزارش سوءاستفاده توسط کاربران، مسدودسازی دوجانبهٔ DM و دفتر ثبت اقدامات مدیریتی

/** مسدودسازی دوجانبه — blocker محتوای DM از/به blocked را نمی‌بیند */
model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/** گزارش سوءاستفاده — صف رسیدگی ادمین در پنل مدیریت */
model UserReport {
  id             String    @id @default(uuid()) @db.Uuid
  reporterId     String    @db.Uuid
  reportedId     String    @db.Uuid
  conversationId String?   @db.Uuid
  reason         String // spam | abuse | impersonation | other
  note           String?
  status         String    @default("open") // open | resolved | dismissed
  /** یادداشت ادمین هنگام رسیدگی */
  resolution     String?
  handledBy      String?   @db.Uuid
  handledAt      DateTime?
  createdAt      DateTime  @default(now())

  reporter User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reportedId])
  @@index([reporterId])
}

/** دفتر ثبت اقدامات مدیریتی — چه کسی، چه کاری، روی چه چیزی، چه وقت */
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /** null = اقدام سیستمی */
  actorId    String?  @db.Uuid
  actorName  String?
  action     String // user.block | user.unblock | report.resolve | report.dismiss | ...
  targetType String? // user | report | system
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

// ————— استوری‌ها (v1.4) —————
// وضعیت ۲۴ ساعته: متن با پس‌زمینه رنگی یا تصویر (از رسانهٔ موجود). بعد از انقضا پاک می‌شود.

model Story {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  /** text | image */
  kind         String    @default("text")
  /** برای kind=text — حداکثر ۲۰۰ کاراکتر */
  text         String?
  /** کلید پس‌زمینهٔ متن (پالت اپ) — aurora | sunset | ocean | forest | night | bloom */
  bgKey        String    @default("aurora")
  /** برای kind=image — بایت تصویر فشرده (کلاینت ≤1280px jpeg می‌فشرده) */
  mediaData    Bytes?
  mediaMime    String?
  /** رنگ متن روی پس‌زمینه */
  textColor    String    @default("#FFFFFF")
  createdAt    DateTime  @default(now())
  /** ۲۴ ساعت بعد از ایجاد */
  expiresAt    DateTime
  viewCount    Int       @default(0)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StoryView[]

  @@index([expiresAt])
  @@index([userId, createdAt])
}

/** بازدید استوری — یک‌بار برای هر (استوری، کاربر) */
model StoryView {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  userId    String   @db.Uuid
  viewedAt  DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId])
}
